{
  "name": "farside",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "contracts",
    "backend",
    "console",
    "infra"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present && npm run lint:azure-spec && npm run lint:reuse-review && npm run lint:azure-estate && npm run lint:operator-runbook && npm run lint:gcp-spec && npm run lint:gcp-estate && npm run lint:plugin && npm run lint:support-matrix",
    "lint:azure-spec": "node scripts/azure-spec/lint.mjs",
    "lint:reuse-review": "node scripts/reuse-review/lint.mjs",
    "lint:azure-estate": "node scripts/azure-estate/lint.mjs",
    "lint:operator-runbook": "node scripts/operator-runbook/lint.mjs",
    "lint:gcp-spec": "node scripts/gcp-spec/lint.mjs",
    "lint:gcp-estate": "node scripts/gcp-estate/lint.mjs",
    "lint:plugin": "node scripts/plugin/lint.mjs && node scripts/plugin/bundle-cli.mjs",
    "plugin:bundle": "node scripts/plugin/bundle-cli.mjs --write",
    "lint:support-matrix": "node scripts/support-matrix/generate.mjs",
    "format": "prettier --write \"console/**/*.{ts,tsx,css,html,json}\"",
    "format:check": "prettier --check \"console/**/*.{ts,tsx,css,html,json}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:azure-spec && npm run test:reuse-review && npm run test:azure-estate && npm run test:operator-runbook && npm run test:gcp-spec && npm run test:gcp-estate && npm run test:plugin && npm run test:support-matrix && npm run test:identity-rehearsal && npm run test --workspaces --if-present",
    "test:azure-spec": "vitest run --config scripts/azure-spec/vitest.config.ts",
    "test:reuse-review": "vitest run --config scripts/reuse-review/vitest.config.ts",
    "test:azure-estate": "vitest run --config scripts/azure-estate/vitest.config.ts",
    "test:operator-runbook": "vitest run --config scripts/operator-runbook/vitest.config.ts",
    "test:gcp-spec": "vitest run --config scripts/gcp-spec/vitest.config.ts",
    "test:gcp-estate": "vitest run --config scripts/gcp-estate/vitest.config.ts",
    "test:plugin": "vitest run --config scripts/plugin/vitest.config.ts",
    "test:support-matrix": "vitest run --config scripts/support-matrix/vitest.config.ts",
    "test:identity-rehearsal": "vitest run --config scripts/identity-rehearsal/vitest.config.ts",
    "identity:rehearse": "node scripts/identity-rehearsal/run.mjs",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
