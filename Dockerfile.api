# Fastify API. Multi-stage: compile in Node 22 slim, run as the
# non-root `node` user. Slim (not distroless) so HEALTHCHECK can
# use Node's built-in fetch against GET /health.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY contracts/package.json contracts/
COPY backend/package.json backend/
COPY console/package.json console/
COPY infra/package.json infra/
RUN npm ci

COPY tsconfig.base.json ./
COPY contracts contracts
COPY backend backend
RUN npm run build -w @farside/scan-contracts && npm run build -w @farside/backend

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080

COPY package.json package-lock.json ./
COPY contracts/package.json contracts/
COPY backend/package.json backend/
COPY console/package.json console/
COPY infra/package.json infra/
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/contracts/dist contracts/dist
COPY --from=build /app/backend/dist backend/dist
COPY docs docs

# Workspace exports resolve `import` to TypeScript source (for Vite).
# Point Node at the compiled package so `node backend/dist/index.js` loads.
RUN node --input-type=module -e "import { readFileSync, writeFileSync } from 'node:fs'; const pkg = JSON.parse(readFileSync('contracts/package.json', 'utf8')); pkg.exports['.'] = { types: './dist/index.d.ts', import: './dist/index.js', default: './dist/index.js' }; writeFileSync('contracts/package.json', JSON.stringify(pkg, null, 2) + String.fromCharCode(10));"

USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8080/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "backend/dist/index.js"]
