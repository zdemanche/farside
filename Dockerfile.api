# Fastify API. Multi-stage: bundle in Node 22 slim, run the single
# self-contained bundle as the
# non-root `node` user. Slim (not distroless) so HEALTHCHECK can
# use Node's built-in fetch against GET /health.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY contracts/package.json contracts/
COPY backend/package.json backend/
COPY console/package.json console/
COPY infra/package.json infra/
RUN npm ci

COPY tsconfig.base.json ./
COPY contracts contracts
COPY backend backend
COPY docs docs
RUN npm run build -w @farside/scan-contracts && npm run build -w @farside/backend

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080

COPY backend/package.json backend/
COPY --from=build /app/backend/dist/index.js backend/dist/index.js

USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8080/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "backend/dist/index.js"]
