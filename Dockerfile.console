# Console static assets. Build with Node 22; serve with
# nginx-unprivileged (non-root, listen 8080). Separate from the API
# so the two images deploy independently.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY contracts/package.json contracts/
COPY backend/package.json backend/
COPY console/package.json console/
COPY infra/package.json infra/
RUN npm ci

COPY tsconfig.base.json ./
COPY contracts contracts
COPY console console
RUN npm run build -w @farside/scan-contracts && npm run build -w @farside/console

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY console/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/console/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
